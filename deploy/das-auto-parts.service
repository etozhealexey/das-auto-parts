[Unit]
Description=Das-Auto-Parts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dasauto
Group=dasauto
WorkingDirectory=/srv/das-auto-parts
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/das-auto-parts/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/das-auto-parts/data
UMask=0077

[Install]
WantedBy=multi-user.target
