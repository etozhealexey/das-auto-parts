# Заменить parts.example.com и пути сертификатов перед установкой.
server {
    listen 80;
    server_name parts.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name parts.example.com;
    ssl_certificate /etc/letsencrypt/live/parts.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/parts.example.com/privkey.pem;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
