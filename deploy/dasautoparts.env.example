# Копировать в /srv/das-auto-parts/.env, владелец dasauto, права 600.
# Значения секретов перенести закрытым способом с Mac после подготовки сервера.
APP_ENV=production
DEBUG=false
SESSION_HTTPS_ONLY=true
ALLOWED_HOSTS=["dasautoparts.ru","www.dasautoparts.ru"]
SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://dasauto:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/dasauto
PRICE_PROVIDER=autoeuro
AUTOEURO_API_KEY=
AUTOEURO_DELIVERY_KEY=
AUTOEURO_PAYER_KEY=
PRICE_MARKUP_PERCENT=15
DELIVERY_EXTRA_DAYS=1
PRICE_CACHE_TTL_MINUTES=30
PRICE_LIST_URL=
PRICE_LIST_WAREHOUSE=Санкт-Петербург ЦС
PRICE_LIST_REFRESH_MINUTES=30
SUPPLIER_ORDERS_ENABLED=false
