# Подключение к PostgreSQL (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://dasauto:dasauto@localhost:5432/dasauto

# Источник цен. autoeuro — реальный API v2, demo — встроенные тестовые данные
PRICE_PROVIDER=demo

# Ключ API autoeuro.ru (выдаётся в личном кабинете shop.autoeuro.ru → API)
AUTOEURO_API_KEY=
# Ключ варианта получения (delivery_key из /get_deliveries; список печатает scripts/autoeuro_check.py).
# Если пусто — берётся первый в списке, это может оказаться другой город
AUTOEURO_DELIVERY_KEY=
# Сколько минут считать закэшированные цены свежими
PRICE_CACHE_TTL_MINUTES=30

# Наценка к цене поставщика, % и сдвиг сроков поставки, дней
PRICE_MARKUP_PERCENT=15
DELIVERY_EXTRA_DAYS=1

DEBUG=true

# Секрет для подписи cookie-сессии. На проде задать длинную случайную строку
SECRET_KEY=change-me-in-production

# Передача заказов клиентов в autoeuro от нашего аккаунта.
# ВКЛЮЧАТЬ ТОЛЬКО НА БОЕВОМ СЕРВЕРЕ: создаёт настоящие заказы и списывает баланс в autoeuro
SUPPLIER_ORDERS_ENABLED=false
# Плательщик (payer_key из /get_payers; список печатает scripts/autoeuro_check.py). Пусто — первый
AUTOEURO_PAYER_KEY=
# Как часто повторять отправку неотправленных заказов, минут
SUPPLIER_ORDERS_RETRY_MINUTES=5
